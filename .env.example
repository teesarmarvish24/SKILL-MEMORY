# Copy this file to .env.local and fill in what you have.
# Everything is optional for local development: without any values the app
# runs with an embedded database, local file storage and keyword "AI".

# --- AI (free): https://aistudio.google.com/apikey -------------------------
GEMINI_API_KEY=
# Optional: comma-separated models to try first (the app falls back automatically)
# GEMINI_MODEL=gemini-3.5-flash

# --- Database: Supabase -> Project Settings -> Database -> Connection string
# Use the "Transaction pooler" URI (port 6543). Leave empty to use local PGlite.
DATABASE_URL=

# --- Storage: Supabase -> Project Settings -> API ---------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=skillmemory-media

# --- Security ----------------------------------------------------------------
# Any long random string (signs login cookies). REQUIRED in production.
SESSION_SECRET=
# Password for /admin. REQUIRED in production (defaults to "admin" locally).
ADMIN_PASSWORD=

# --- Optional ------------------------------------------------------------------
# Public address used in WhatsApp links (e.g. https://skillmemory.vercel.app)
NEXT_PUBLIC_SITE_URL=
# Set to 0 to hide the labelled sample profiles
SHOW_SAMPLES=1
